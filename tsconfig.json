{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./vendor/shared/*"
      ]
    }
  },
  "include": [
    "app.tsx",
    "server.ts",
    "src",
    "lib",
    "vendor",
    "tests",
    "vitest.config.ts"
  ]
}
